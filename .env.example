# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (never commit a real password)
DATABASE_URL=postgresql://mahvara:change-me@localhost:5432/mahvara?schema=public

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=mahvara_session

# Demo seed credentials (change or remove in production)
DEMO_ADMIN_EMAIL=admin@mahvara.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_CUSTOMER_EMAIL=customer@mahvara.local
DEMO_CUSTOMER_PASSWORD=ChangeMe123!

# Payment adapter: mock | iranian-provider-name
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payments/callback

# Optional analytics; app remains healthy when empty
NEXT_PUBLIC_ANALYTICS_ID=

# Abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Configurable social profiles; leave blank until ownership is confirmed
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
